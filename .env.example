# Active notification channel: telegram | max | both
NOTIFICATION_CHANNEL=telegram

# Production outside Vercel defaults to https://pappare.vercel.app/api/reservations.
# Optional override on the VPS; use "direct" only if Telegram is reachable.
# Vercel always delivers directly, preventing relay loops.
RESERVATION_RELAY_URL=

# Cinema remains a demo until a database and payment provider are configured.
CINEMA_DEMO=true

# Telegram Bot API
# 1. Create a bot via @BotFather
# 2. Add the bot to the admin chat or channel
# 3. Get chat id via getUpdates or a helper bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-secret
TELEGRAM_ADMIN_IDS=
# Optional shared VPS/Vercel secret when the VPS has no TELEGRAM_BOT_TOKEN.
# At least 32 random characters; same value on both deployments. Never commit a real value.
RESERVATION_RELAY_SECRET=

# Optional PostgreSQL connection string for reservation history.
# Booking works without PostgreSQL in Telegram-only mode.
DATABASE_URL=

# MAX notification adapter
# Fill these values when MAX API credentials and recipient are available.
MAX_API_ENDPOINT=
MAX_BOT_TOKEN=
MAX_RECIPIENT_ID=

# Cinema admin requires PostgreSQL in production (DATABASE_URL above).
# Generate on the VPS: openssl rand -hex 32. Do not use the local preview key.
CINEMA_ADMIN_SECRET=
CINEMA_ADMIN_TOTP_SECRET=
CINEMA_SERVICE_SECRET=
# Optional exact IP addresses, comma-separated. Leave empty for dynamic/mobile IPs.
CINEMA_ADMIN_ALLOWED_IPS=
CINEMA_PUBLIC_ORIGIN=https://pappare.ru
CINEMA_HOLD_MINUTES=10
# Set CINEMA_DEMO=false above for real admin bookings/Telegram notifications.
# This does not open online sales; YooKassa integration is still pending.

# Optional separate database for cinema; falls back to DATABASE_URL.
CINEMA_DATABASE_URL=

# YooKassa Smart Payment + Cheki ot YooKassa (the service must be enabled in the shop).
# Save the live key ONLY in .env.production.local on the VPS, never in Git or chat.
PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=1487524
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST=false
# Open sales only after credentials, webhook and receipt checks are ready.
CINEMA_ONLINE_SALES=false
# VAT is fixed to 1 (no VAT), service, full prepayment.
# Tax regime (patent) is managed with YooKassa; its receipt service does not list tax_system_code.
